+      if (ShiftAmt >= 0) {
+        Result = emitShlByte(MBB, MI, DL, SrcReg, ShiftAmt, MRI);
+      } else {
+        // Variable shift: a DJNZ loop, with the count in B.
+        BuildMI(MBB, MI, DL, TII.get(TargetOpcode::COPY), Z80::B)
