+; SPDX-License-Identifier: Zlib OR Apache-2.0 WITH LLVM-exception OR MIT
+	.area _CODE
+	.globl ___umodqi3
+
+;===------------------------------------------------------------------------===;
+; ___umodqi3 - 8-bit unsigned modulo (remainder)
+;
+; Input:  A = dividend, L = divisor
+; Output: A = remainder
+; Clobbers: B, D, FLAGS
+;===------------------------------------------------------------------------===;
+___umodqi3:
+	ld	d, a		; D = dividend
+	xor	a		; A = 0 (remainder)
+	ld	b, #8		; 8-bit counter
+___umodqi3_loop:
+	sla	d		; shift dividend MSB -> carry
+	rla			; remainder = remainder*2 + carry
+	cp	l		; compare remainder with divisor
+	jr	c, ___umodqi3_skip
+	sub	l		; remainder -= divisor
+	inc	d		; set quotient bit
+___umodqi3_skip:
+	djnz	___umodqi3_loop
+	; A = remainder (already in A)
+	ret
diff --git a/compiler-rt/lib/builtins/z80/umulhi3.asm b/compiler-rt/lib/builtins/z80/umulhi3.asm
new file mode 100644
index 000000000..71bffc44f
--- /dev/null
+++ b/compiler-rt/lib/builtins/z80/umulhi3.asm
@@ -0,0 +1,36 @@
+; SPDX-License-Identifier: Zlib OR Apache-2.0 WITH LLVM-exception OR MIT
+	.area _CODE
+	.globl ___umulhi3
+
+;===------------------------------------------------------------------------===;
+; ___umulhi3 - High half of the unsigned 16x16 product
+;
+; Input:  HL = a, DE = b
+; Output: DE = (a * b) >> 16, HL = (a * b) & 0xFFFF (__mulsi3 uses both)
+;
+; MSB-first shift-and-add over DE:HL: the multiplier in DE shifts out as the
+; product shifts in. A multiplier below 256 takes 8 steps.
+;===------------------------------------------------------------------------===;
+___umulhi3:
+	ld	b, h
+	ld	c, l
+	ld	hl, #0
+	ld	a, d
+	or	a
+	ld	a, #16
+	jr	nz, ___umulhi3_loop
+	ld	d, e
+	ld	e, h
+	ld	a, #8
+___umulhi3_loop:
+	add	hl, hl
+	rl	e
+	rl	d
+	jr	nc, ___umulhi3_next
+	add	hl, bc
+	jr	nc, ___umulhi3_next
+	inc	de
+___umulhi3_next:
+	dec	a
+	jr	nz, ___umulhi3_loop
+	ret
diff --git a/compiler-rt/lib/builtins/z80/z80.ld b/compiler-rt/lib/builtins/z80/z80.ld
new file mode 100644
index 000000000..ab0e2ec22
--- /dev/null
+++ b/compiler-rt/lib/builtins/z80/z80.ld
@@ -0,0 +1,18 @@
+/* Z80 default linker script for lld.
+ * Flat memory model: code starts at 0x0000, data follows.
+ */
+ENTRY(_start)
+
+SECTIONS {
+  . = 0x0000;
+  .text : { *(.text*) *(.rodata*) }
+  .data : { *(.data*) }
+  .bss  : {
+    __bss_start = .;
+    *(.bss*) *(COMMON)
+    __bss_end = .;
+  }
+  __bss_size = __bss_end - __bss_start;
+
+  /DISCARD/ : { *(.comment) *(.eh_frame*) }
+}
diff --git a/lld/ELF/Arch/Z80.cpp b/lld/ELF/Arch/Z80.cpp
new file mode 100644
index 000000000..a82714583
--- /dev/null
+++ b/lld/ELF/Arch/Z80.cpp
@@ -0,0 +1,245 @@
+//===- Z80.cpp ------------------------------------------------------------===//
+//
+// Part of LLVM-Z80, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// The Z80 is an 8-bit microprocessor with a 16-bit address bus (64KB address
+// space). This is a static-only target with no dynamic linking, PLT/GOT,
+// or TLS support. The Z80 backend also covers the SM83 (Game Boy CPU).
+//
+//===----------------------------------------------------------------------===//
+
+#include "InputFiles.h"
+#include "OutputSections.h"
+#include "Symbols.h"
+#include "Target.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/BinaryFormat/ELF.h"
+#include "llvm/Support/Endian.h"
+
+using namespace llvm;
+using namespace llvm::object;
+using namespace llvm::support::endian;
+using namespace llvm::ELF;
+using namespace lld;
+using namespace lld::elf;
+
+namespace {
+class Z80 final : public TargetInfo {
+public:
+  Z80(Ctx &);
+  uint32_t calcEFlags() const override;
+  RelExpr getRelExpr(RelType type, const Symbol &s,
+                     const uint8_t *loc) const override;
+  void relocate(uint8_t *loc, const Relocation &rel,
+                uint64_t val) const override;
+  void relocateAlloc(InputSectionBase &sec, uint8_t *buf) const override;
+
+private:
+  void checkLDH(InputSectionBase &sec, uint8_t *buf) const;
+};
+} // namespace
+
+Z80::Z80(Ctx &ctx) : TargetInfo(ctx) {
+  // HALT instruction (0x76) as trap/padding.
+  trapInstr = {0x76, 0x76, 0x76, 0x76};
+  defaultImageBase = 0;
+  defaultMaxPageSize = 1;
+  defaultCommonPageSize = 1;
+}
+
+// Whether an object for CPU `inner` may be linked into a program for CPU
+// `outer`, following the binutils rules.
+static bool linksInto(uint32_t inner, uint32_t outer) {
+  if (inner == outer)
+    return true;
+  switch (outer) {
+  case EF_Z80_MACH_Z80:
+  case EF_Z80_MACH_SM83:
+    return false;
+  case EF_Z80_MACH_Z180:
+  case EF_Z80_MACH_R800:
+  case EF_Z80_MACH_Z80N:
+    return inner == EF_Z80_MACH_Z80;
+  case EF_Z80_MACH_EZ80_Z80:
+    return inner == EF_Z80_MACH_Z80 || inner == EF_Z80_MACH_Z180;
+  case EF_Z80_MACH_EZ80_ADL:
+    return inner == EF_Z80_MACH_Z80 || inner == EF_Z80_MACH_Z180 ||
+           inner == EF_Z80_MACH_EZ80_Z80;
+  default:
+    return false;
+  }
+}
+
+static std::string cpuName(uint32_t mach) {
+  switch (mach) {
+  case EF_Z80_MACH_Z80:
+    return "Z80";
+  case EF_Z80_MACH_Z180:
+    return "Z180";
+  case EF_Z80_MACH_R800:
+    return "R800";
+  case EF_Z80_MACH_EZ80_Z80:
+    return "eZ80";
+  case EF_Z80_MACH_EZ80_ADL:
+    return "eZ80 ADL";
+  case EF_Z80_MACH_SM83:
+    return "SM83";
+  case EF_Z80_MACH_Z80N:
+    return "Z80N";
+  default:
+    return "CPU 0x" + utohexstr(mach);
+  }
+}
+
+static uint32_t getMach(InputFile *f) {
+  uint32_t mach = cast<ObjFile<ELF32LE>>(f)->getObj().getHeader().e_flags &
+                  EF_Z80_MACH_MSK;
+  // binutils reads an object without a CPU value as plain Z80.
+  return mach ? mach : EF_Z80_MACH_Z80;
+}
+
+// The output takes the most capable input CPU, and every input must be
+// linkable with it.
+uint32_t Z80::calcEFlags() const {
+  if (ctx.objectFiles.empty())
+    return EF_Z80_MACH_Z80;
+
+  InputFile *machFile = ctx.objectFiles[0];
+  uint32_t mach = getMach(machFile);
+  for (InputFile *f : ArrayRef(ctx.objectFiles).slice(1)) {
+    uint32_t objMach = getMach(f);
+    if (linksInto(mach, objMach)) {
+      mach = objMach;
+      machFile = f;
+    } else if (!linksInto(objMach, mach)) {
+      ErrAlways(ctx) << f << ": cannot link " << cpuName(objMach)
+                     << " code with " << cpuName(mach) << " code from "
+                     << machFile;
+    }
+  }
+  return mach;
+}
+
+RelExpr Z80::getRelExpr(RelType type, const Symbol &s,
+                        const uint8_t *loc) const {
+  switch (type) {
+  case R_Z80_8_PCREL:
+    return R_PC;
+  case R_Z80_NONE:
+    return R_NONE;
+  default:
+    return R_ABS;
+  }
+}
+
+void Z80::relocate(uint8_t *loc, const Relocation &rel, uint64_t val) const {
+  switch (rel.type) {
+  case R_Z80_NONE:
+    break;
+  case R_Z80_8: {
+    // SM83: checkLDH() checks that an LDH operand is in the high page.
+    uint8_t hi = (val >> 8) & 0xff;
+    if (hi != 0 && hi != 0xff)
+      reportRangeError(ctx, loc, rel, Twine((int64_t)val), -256, 255);
+    *loc = val;
+    break;
+  }
+  case R_Z80_8_DIS:
+  case R_Z80_8_PCREL:
+    checkInt(ctx, loc, (int64_t)val, 8, rel);
+    *loc = val;
+    break;
+  case R_Z80_16:
+    checkIntUInt(ctx, loc, val, 16, rel);
+    write16le(loc, val);
+    break;
+  case R_Z80_16_BE:
+    checkIntUInt(ctx, loc, val, 16, rel);
+    write16be(loc, val);
+    break;
+  case R_Z80_24:
+    checkIntUInt(ctx, loc, val, 24, rel);
+    loc[0] = val;
+    loc[1] = val >> 8;
+    loc[2] = val >> 16;
+    break;
+  case R_Z80_32:
+    write32le(loc, val);
+    break;
+  case R_Z80_BYTE0:
+    *loc = val;
+    break;
+  case R_Z80_BYTE1:
+    *loc = val >> 8;
+    break;
+  case R_Z80_BYTE2:
+    *loc = val >> 16;
+    break;
+  case R_Z80_BYTE3:
+    *loc = val >> 24;
+    break;
+  case R_Z80_WORD0:
+    write16le(loc, val);
+    break;
+  case R_Z80_WORD1:
+    write16le(loc, val >> 16);
+    break;
+  default:
+    Err(ctx) << getErrorLoc(ctx, loc) << "unrecognized relocation " << rel.type;
+  }
+}
+
+// Whether the byte at off is code, from the $x and $d mapping symbols.
+static std::optional<bool> isCodeAt(const InputSectionBase &sec, uint64_t off) {
+  std::optional<bool> code;
+  uint64_t start = 0;
+  for (Symbol *sym : cast<ELFFileBase>(sec.file)->getLocalSymbols()) {
+    auto *d = dyn_cast_or_null<Defined>(sym);
+    if (!d || d->section != &sec || d->value > off ||
+        (code && d->value < start) ||
+        (d->getName() != "$x" && d->getName() != "$d"))
+      continue;
+    start = d->value;
+    code = d->getName() == "$x";
+  }
+  return code;
+}
+
+// relocate() lets an LDH operand like 0x0080 pass,
+// so check that an R_Z80_8 after an LDH opcode is in 0xFF00-0xFFFF.
+void Z80::checkLDH(InputSectionBase &sec, uint8_t *buf) const {
+  uint64_t secAddr = sec.getOutputSection()->addr + cast<InputSection>(sec).outSecOff;
+  ArrayRef<uint8_t> data = sec.content();
+  for (const Relocation &rel : sec.relocs()) {
+    if (rel.type != R_Z80_8 || rel.offset == 0 ||
+        (data[rel.offset - 1] != 0xe0 && data[rel.offset - 1] != 0xf0))
+      continue;
+    uint64_t val = sec.getRelocTargetVA(ctx, rel, secAddr + rel.offset);
+    if (((val >> 8) & 0xff) != 0)
+      continue;
+    std::optional<bool> code = isCodeAt(sec, rel.offset);
+    if (code == false)
+      continue;
+    auto diag = code ? Err(ctx) : Warn(ctx);
+    diag << getErrorLoc(ctx, buf + rel.offset)
+         << (code ? "LDH address 0x" : "possible LDH address 0x")
+         << utohexstr(uint32_t(val)) << " is not in [0xff00, 0xffff]";
+    if (rel.sym && !rel.sym->isSection())
+      diag << "; references '" << rel.sym << '\'';
+  }
+}
+
+void Z80::relocateAlloc(InputSectionBase &sec, uint8_t *buf) const {
+  TargetInfo::relocateAlloc(sec, buf);
+  auto *file = dyn_cast_or_null<ObjFile<ELF32LE>>(sec.file);
+  if ((sec.flags & SHF_EXECINSTR) && file &&
+      (file->getObj().getHeader().e_flags & EF_Z80_MACH_MSK) ==
+          EF_Z80_MACH_SM83)
+    checkLDH(sec, buf);
+}
+
+void elf::setZ80TargetInfo(Ctx &ctx) { ctx.target.reset(new Z80(ctx)); }
