+//===---------------------------------------------------------------------===//
+
+// Zilog Z180 (enhanced Z80)
+def : Proc<"z180", [FeatureZ180]>;
+
+// Hitachi HD64180
+def : Proc<"hd64180", [FeatureZ180]>;
+
+//===---------------------------------------------------------------------===//
+// R800 (MSX TurboR)
+//===---------------------------------------------------------------------===//
+
+def : Proc<"r800", [FeatureR800]>;
+
+//===---------------------------------------------------------------------===//
+// eZ80 Series (24-bit)
+//===---------------------------------------------------------------------===//
+
+def : Proc<"ez80", [FeatureEZ80]>;
+
+//===---------------------------------------------------------------------===//
+// Sharp SM83 (Game Boy)
+//===---------------------------------------------------------------------===//
+
+// Sharp SM83 (LR35902)
+def : Proc<"sm83", [FeatureSM83], SM83Model>;
+def : Proc<"gbz80", [FeatureSM83], SM83Model>;
