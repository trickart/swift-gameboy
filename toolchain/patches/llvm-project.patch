+	ldhl	sp, #2
+	ld	a, (hl+)
+	ld	h, (hl)
+	ld	l, a		; HL = sret pointer
+	call	__neg128_mem
+___modti3_done:
+	pop	hl		; return address
+	add	sp, #34		; callee-cleanup: skip sret(2) + args(32)
+	jp	(hl)
