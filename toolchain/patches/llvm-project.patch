+	jr	nc, __ufdi_saturate
+
+	set	7, e		; 24-bit mantissa in E:B:C
+
+	ld	a, d
+	cp	#190
+	jr	z, __ufdi_top
+
+	sub	#150
+	jr	c, __ufdi_rshift
+
+	; --- Left shift path: shift in 0..39 ---
+	push	af
+	ld	d, #0
+	and	#7
+	jr	z, __ufdi_lsh_done
+	ld	l, a
+__ufdi_lsh_lp:
+	sla	c
+	rl	b
+	rl	e
+	rl	d
+	dec	l
+	jr	nz, __ufdi_lsh_lp
+__ufdi_lsh_done:
+	pop	af
+	rrca
+	rrca
+	rrca
+	and	#0x1F		; byte offset
+	push	af
+	ldhl	sp, #4		; stack: offset, ret, sret
+	ld	a, (hl+)
+	ld	h, (hl)
+	ld	l, a
+	pop	af
+	add	a, l
+	ld	l, a
+	ld	a, #0
+	adc	a, h
+	ld	h, a
+	ld	a, c
+	ld	(hl+), a
+	ld	a, b
+	ld	(hl+), a
+	ld	a, e
+	ld	(hl+), a
+	ld	a, d
+	ld	(hl+), a
+	jr	__ufdi_done
+
+__ufdi_top:
