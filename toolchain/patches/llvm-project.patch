+Z80CallLowering::Z80CallLowering(const TargetLowering *TL)
+    : Z80CallLoweringCommon(TL,
+                            // sdcccall(1) registers
+                            CallingConvRegs{
+                                /*First_I16=*/Z80::HL,
+                                /*First_I32_Hi=*/Z80::HL,
+                                /*First_I32_Lo=*/Z80::DE,
+                                /*Second_AfterI8_I8=*/Z80::L,
+                                /*Second_AfterI8_I16=*/Z80::DE,
+                                /*Second_AfterI16_I8=*/Register(),
+                                /*Second_AfterI16_I16=*/Z80::DE,
+                                /*Ret_I8=*/Z80::A,
+                                /*Ret_I16=*/Z80::DE,
+                                /*Ret_I32_Hi=*/Z80::HL,
+                                /*Ret_I32_Lo=*/Z80::DE,
+                                /*IndirectCallReg=*/Z80::IY,
+                                /*First_I8=*/Register(),
+                                /*Third_I16=*/Z80::BC,
+                                /*Half_1=*/Z80::L,
+                                /*Half_2=*/Z80::E,
+                                /*Half_3=*/Z80::C,
+                            },
+                            // z88dk block: the stack conventions read only
+                            // the return half, and __z88dk_fastcall passes its
+                            // sole argument in those same registers.
+                            CallingConvRegs{
+                                /*First_I16=*/Z80::HL,
+                                /*First_I32_Hi=*/Z80::DE,
+                                /*First_I32_Lo=*/Z80::HL,
+                                /*Second_AfterI8_I8=*/Register(),
+                                /*Second_AfterI8_I16=*/Register(),
+                                /*Second_AfterI16_I8=*/Register(),
+                                /*Second_AfterI16_I16=*/Register(),
+                                /*Ret_I8=*/Z80::L,
+                                /*Ret_I16=*/Z80::HL,
+                                /*Ret_I32_Hi=*/Z80::DE,
+                                /*Ret_I32_Lo=*/Z80::HL,
+                                /*IndirectCallReg=*/Z80::IY,
+                                /*First_I8=*/Z80::L,
+                            }) {}
