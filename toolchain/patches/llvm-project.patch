+	add	a, a
+	ld	d, a
+	ld	a, e
+	rlca
+	and	#1
+	or	d
+	ld	d, a		; D = exponent
+
+	inc	a
+	jr	nz, __ufdi_finite
+	ld	a, e
+	and	#0x7F
