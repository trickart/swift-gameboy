+	; three, leaving nothing for a fourth byte to carry.
+	ldhl	sp, #2
+	ld	a, (hl+)
+	ld	h, (hl)
+	ld	l, a
+	ld	a, l
+	add	a, #5
+	ld	l, a
+	ld	a, h
+	adc	a, #0
+	ld	h, a
+	ld	a, c
+	ld	(hl+), a
+	ld	a, b
+	ld	(hl+), a
+	ld	a, e
+	ld	(hl), a
+	jr	__ufdi_done
+
+	; --- Right shift path: shift in -23..-1 ---
+__ufdi_rshift:
+	cpl
+	inc	a		; A = 1..23
+__ufdi_rsh_lp:
+	srl	e
+	rr	b
+	rr	c
+	dec	a
+	jr	nz, __ufdi_rsh_lp
+	ldhl	sp, #2
+	ld	a, (hl+)
+	ld	h, (hl)
+	ld	l, a
+	ld	a, c
+	ld	(hl+), a
+	ld	a, b
+	ld	(hl+), a
+	ld	a, e
+	ld	(hl), a
+
+__ufdi_done:
+	pop	hl		; return address
+	add	sp, #2		; callee-cleanup: skip the sret slot
+	jp	(hl)
+
+__ufdi_saturate:
+	ldhl	sp, #2
+	ld	a, (hl+)
+	ld	h, (hl)
+	ld	l, a
+	ld	d, #8
+__ufdi_sat_lp:
+	ld	a, #0xFF
+	ld	(hl+), a
+	dec	d
+	jr	nz, __ufdi_sat_lp
+	jr	__ufdi_done
