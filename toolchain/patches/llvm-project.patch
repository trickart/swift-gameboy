+      // Masking with 1 a value selection builds as exactly 0 or 1 keeps it
+      // as it is.
+      auto isMaskedBool = [&](Register Val, Register Mask) {
+        auto M = getConst8(Mask);
+        return M && (*M & 0xFF) == 1 && isSelectedBool(Val, MRI);
+      };
