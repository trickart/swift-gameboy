@@ -0,0 +1,26 @@
+; SPDX-License-Identifier: Zlib OR Apache-2.0 WITH LLVM-exception OR MIT
+	.area _CODE
+	.globl _strchr
+
+;===------------------------------------------------------------------------===;
+; _strchr - Find character in string
+;
+; Input:  HL = string, DE = character (E = char)
+; Output: DE = pointer to char, or 0 if not found
+;===------------------------------------------------------------------------===;
+
+_strchr:
+_strchr_loop:
+	ld	a, (hl)
+	cp	e
+	jr	z, _strchr_found
+	or	a
+	jr	z, _strchr_notfound
+	inc	hl
+	jr	_strchr_loop
+_strchr_found:
+	ex	de, hl		; DE = pointer to match
+	ret
+_strchr_notfound:
+	ld	de, #0
+	ret
diff --git a/compiler-rt/lib/builtins/z80/strcmp.asm b/compiler-rt/lib/builtins/z80/strcmp.asm
new file mode 100644
index 000000000..d1e184845
--- /dev/null
+++ b/compiler-rt/lib/builtins/z80/strcmp.asm
@@ -0,0 +1,31 @@
+; SPDX-License-Identifier: Zlib OR Apache-2.0 WITH LLVM-exception OR MIT
+	.area _CODE
+	.globl _strcmp
+
+;===------------------------------------------------------------------------===;
+; _strcmp - Compare two null-terminated strings
+;
+; Input:  HL = str1, DE = str2
+; Output: DE = negative/zero/positive (str1 <=> str2)
+;===------------------------------------------------------------------------===;
+_strcmp:
+	ld	a, (de)
+	ld	b, a		; B = *str2
+	ld	a, (hl)		; A = *str1
+	cp	b		; zero if equal, carry if *str1 < *str2
+	jr	nz, _strcmp_diff
+	or	a		; A is still *str1; zero means both ended
+	jr	z, _strcmp_eq
+	inc	hl
+	inc	de
+	jr	_strcmp
+_strcmp_eq:
+	ld	de, #0
+	ret
+_strcmp_diff:
+	jr	c, _strcmp_less
+	ld	de, #1
+	ret
+_strcmp_less:
+	ld	de, #0xFFFF
+	ret
