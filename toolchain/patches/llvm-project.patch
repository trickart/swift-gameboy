+#endif // not LLVM_LIB_TARGET_Z80_SM83CALLLOWERING_H
diff --git a/llvm/lib/Target/Z80/SM83CallingConv.td b/llvm/lib/Target/Z80/SM83CallingConv.td
new file mode 100644
index 000000000..b3aa6b2dd
--- /dev/null
+++ b/llvm/lib/Target/Z80/SM83CallingConv.td
@@ -0,0 +1,64 @@
+//===-- SM83CallingConv.td - Calling Conventions SM83 ------*- tablegen -*-===//
+//
+// Part of LLVM-Z80, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This describes the calling conventions for the SM83 (Game Boy CPU).
+//
+//===----------------------------------------------------------------------===//
+//
+// SM83 Calling Convention Notes (SDCC __sdcccall(1) compatible):
+//
+// SM83 differs from Z80: HL is reserved for memory access and never
+// used for argument/return passing.
+//
+// Register usage:
+// - A: Accumulator, first 8-bit parameter and 8-bit return value
+// - DE: First 16-bit parameter
+// - BC: Second 16-bit parameter and 16-bit return value
+// - HL: Memory access only (not used for args/returns)
+// - SP: Stack pointer
+//
+// Caller-saved: A, F, B, C, D, E, H, L (all GPRs)
+// Callee-saved: none
+//
+// Arguments (max 2 register params):
+//   1st i8  -> A,    2nd i8  -> E,     2nd i16 -> DE
+//   1st i16 -> DE,   2nd i8  -> A,     2nd i16 -> BC
+//   1st i32 -> DEBC, 2nd any -> stack
+//   3rd+ always on stack (right to left push order)
+//   Arg positions are consumed regardless of register assignment success.
+//
+// Stack argument packing:
+//   i8 args are packed as 1 byte (push af; inc sp), NOT 2-byte aligned.
+//   i16/i32/i64 args are naturally sized (2/4/8 bytes).
+//
+// Return values:
+// - 8-bit:  A
+// - 16-bit: BC
+// - 32-bit: DEBC (DE high, BC low)
+// - >32-bit: via sret pointer (hidden stack argument, see below)
+//
+// Sret (structure return) convention:
+//   When the return type exceeds 32 bits (e.g., i64), the caller allocates
+//   a buffer and pushes its address on the stack as a hidden first argument.
+//   The sret pointer does NOT consume a register slot — regular arguments
+//   still use DE/BC normally. The sret pointer is at the lowest stack
+//   address (pushed last by caller, first thing after return address in
+//   callee's frame).
+//
+// Callee-cleanup rules:
+//   Non-variadic functions always use callee-cleanup (SM83 has no
+//   conditional callee-cleanup based on return type, unlike Z80).
+//
+//===----------------------------------------------------------------------===//
+
+// SM83 SDCC __sdcccall(1): no callee-saved registers.
+// SM83 lacks IX/IY entirely; all GPRs are caller-saved.
+def SM83_CSR : CalleeSavedRegs<(add)>;
+
+// SM83 interrupt handler saves all register pairs (no IX/IY on SM83)
+def SM83_Interrupt_CSR : CalleeSavedRegs<(add AF, BC, DE, HL)>;
diff --git a/llvm/lib/Target/Z80/SM83InstrInfo.td b/llvm/lib/Target/Z80/SM83InstrInfo.td
new file mode 100644
index 000000000..d9b50ca46
--- /dev/null
+++ b/llvm/lib/Target/Z80/SM83InstrInfo.td
@@ -0,0 +1,165 @@
+//===-- SM83InstrInfo.td - SM83-only instructions ----------*- tablegen -*-===//
+//
+// Part of LLVM-Z80, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// SM83 (Game Boy CPU) instructions that do not exist on Z80.
+// On Z80, these opcode slots are used for different instructions.
+//
+//===----------------------------------------------------------------------===//
+
+let Predicates = [HasSM83], DecoderNamespace = "SM83" in {
+
+//===----------------------------------------------------------------------===//
+//  Hardware Instructions
+//===----------------------------------------------------------------------===//
+
+// SWAP A - Swap upper and lower nibbles of A (CB 37)
+// On Z80, this opcode slot (CB 0b110rrr) is the undocumented SLL.
+// SM83 uses it as a nibble swap instruction.
+def SWAP_A : InstCB<"swap a", 0x37> {
+  let Uses = [A];
+  let Defs = [A, FLAGS];
+}
+
+// SM83 RETI - Return from interrupt (opcode 0xD9)
+// Unlike Z80 RETI (ED 4D), SM83 RETI is a single-byte instruction
+// that atomically enables interrupts (IME=1) and returns.
+// No conflict: SM83 DecoderNamespace separates from Z80's EXX (also 0xD9).
+def SM83_RETI : Inst8<"reti", 0xD9>, InstReturn;
+
+// LDHL SP,e - Load SP + signed 8-bit offset into HL (opcode 0xF8)
+// sdasgb syntax: ldhl sp,#imm
+def LDHL_SP_e : Inst16SImm<"ldhl sp,", 0xF8> {
+  let Uses = [SP];
+  let Defs = [HL, FLAGS];
+  let mayLoad = 0;
+  let mayStore = 0;
+  let hasSideEffects = 0;
+}
+
+// ADD SP,e - Add signed 8-bit immediate to SP (opcode 0xE8)
+// sdasgb syntax: add sp,#imm
+def ADD_SP_e : Inst16SImm<"add sp,", 0xE8> {
+  let Uses = [SP];
+  let Defs = [SP, FLAGS];
+}
+
+// LD (nn),A - Store A to direct address (opcode 0xEA)
+// Z80 uses 0x32 for this; SM83 0x32 is LD (HL-),A.
+let mayLoad = false, mayStore = true, hasSideEffects = false in
+def SM83_LD_nnind_A : Inst24<"ld", 0xEA, DirectMode> {
+  let AsmString = "ld ( $imm ),a";
+  let Uses = [A];
+}
+
+// LD A,(nn) - Load A from direct address (opcode 0xFA)
+// Z80 uses 0x3A for this; SM83 0x3A is LD A,(HL-).
+let mayLoad = true, mayStore = false, hasSideEffects = false in
+def SM83_LD_A_nnind : Inst24<"ld a,", 0xFA, DirectMode> {
+  let Defs = [A];
+}
+
+// LD (HL+),A - Store A to (HL) then increment HL (opcode 0x22)
+// Z80 uses 0x22 for LD (nn),HL.
+// sdasgb syntax: ld (hl+),a
+def LD_HLI_A : Inst8<"ld (hl+), a", 0x22> {
+  let Uses = [HL, A];
+  let Defs = [HL];
+  let mayLoad = false;
+  let mayStore = true;
+}
+
+// LD A,(HL+) - Load (HL) to A then increment HL (opcode 0x2A)
+// Z80 uses 0x2A for LD HL,(nn).
+// sdasgb syntax: ld a,(hl+)
+def LD_A_HLI : Inst8<"ld a, (hl+)", 0x2A> {
+  let Uses = [HL];
+  let Defs = [A, HL];
+  let mayLoad = true;
+  let mayStore = false;
+}
+
+// LD (HL-),A - Store A to (HL) then decrement HL (opcode 0x32)
+// Z80 uses 0x32 for LD (nn),A.
+// sdasgb syntax: ld (hl-),a
+def LD_HLD_A : Inst8<"ld (hl-), a", 0x32> {
+  let Uses = [HL, A];
+  let Defs = [HL];
+  let mayLoad = false;
+  let mayStore = true;
+}
+
+// LD A,(HL-) - Load (HL) to A then decrement HL (opcode 0x3A)
+// Z80 uses 0x3A for LD A,(nn).
+// sdasgb syntax: ld a,(hl-)
+def LD_A_HLD : Inst8<"ld a, (hl-)", 0x3A> {
+  let Uses = [HL];
+  let Defs = [A, HL];
+  let mayLoad = true;
+  let mayStore = false;
+}
+
+//===----------------------------------------------------------------------===//
+//  Pseudo Instructions
+//===----------------------------------------------------------------------===//
+
+// Indirect call through HL via __call_hl trampoline.
+let isPseudo = true in
+def CALL_HL : Z80Inst<"call\t__call_hl">, InstCall {
+  let InOperandList = (ins);
+  let Uses = [HL];
+  let Defs = [A, BC, DE, HL, FLAGS];
+}
+
+//===----------------------------------------------------------------------===//
+//  LDH Instructions (0xFF00 + 8-bit offset)
+//===----------------------------------------------------------------------===//
+
+// LDH (n),A - Store A to high page address 0xFF00+n (opcode 0xE0)
+let mayLoad = false, mayStore = true, hasSideEffects = true in
+def SM83_LDH_nind_A : Z80Inst<"ldh"> {
+  let Size = 2;
+  bits<8> port;
+  bits<16> Inst;
+  let Inst{7-0} = 0xE0;
+  let Inst{15-8} = port;
+  let InOperandList = (ins hram8:$port);
+  let AsmString = "ldh ( $port ), a";
+  let Uses = [A];
+}
+
+// LDH A,(n) - Load A from high page address 0xFF00+n (opcode 0xF0)
+let mayLoad = true, mayStore = false, hasSideEffects = true in
+def SM83_LDH_A_nind : Z80Inst<"ldh a,"> {
+  let Size = 2;
+  bits<8> port;
+  bits<16> Inst;
+  let Inst{7-0} = 0xF0;
+  let Inst{15-8} = port;
+  let InOperandList = (ins hram8:$port);
+  let AsmString = "ldh a, ( $port )";
+  let Defs = [A];
+}
+
+// LDH (C),A - Store A to address 0xFF00+C (opcode 0xE2)
+def SM83_LDH_Cind_A : Inst8<"ldh (c), a", 0xE2> {
+  let Uses = [A, C];
+  let mayLoad = false;
+  let mayStore = true;
+  let hasSideEffects = true;
+}
+
+// LDH A,(C) - Load from address 0xFF00+C to A (opcode 0xF2)
+def SM83_LDH_A_Cind : Inst8<"ldh a, (c)", 0xF2> {
+  let Uses = [C];
+  let Defs = [A];
+  let mayLoad = true;
+  let mayStore = false;
+  let hasSideEffects = true;
+}
+
+} // Predicates = [HasSM83]
