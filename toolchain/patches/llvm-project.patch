+    MachineMemOperand *MMO = MF.getMachineMemOperand(
+        MachinePointerInfo::getJumpTable(MF), MachineMemOperand::MOLoad,
+        EntrySize, Align(MJTI->getEntryAlignment(MF.getDataLayout())));
